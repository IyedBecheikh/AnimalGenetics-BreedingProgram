<!-- Health-tab operations (doctors). Generated list; see Tests and Source/Operations.cs. -->
<Defs>

  <RecipeDef Name="AGB_GermlineOperationBase" ParentName="SurgeryFlesh" Abstract="True">
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <researchPrerequisite>AGB_GermlineBanking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef ParentName="AGB_GermlineOperationBase">
    <defName>AGB_Operation_CollectGermline</defName>
    <label>collect germline sample</label>
    <description>Collect a germline sample from this male. The sample keeps his exact genes and can be used to inseminate females later, even after he is gone. Viable for 3 days unless frozen or kept in a powered cryobank.</description>
    <workerClass>AnimalGeneticsBreeding.Recipe_CollectGermline</workerClass>
    <jobString>Collecting a germline sample.</jobString>
    <workAmount>400</workAmount>
    <genderPrerequisite>Male</genderPrerequisite>
  </RecipeDef>

  <RecipeDef ParentName="AGB_GermlineOperationBase">
    <defName>AGB_Operation_Inseminate</defName>
    <label>inseminate (best sample)</label>
    <description>Inseminate this female with the best matching germline sample on the map (the one with the highest expected child score). Success chance: 60% plus 3% per Medicine level, up to 95%. To pick a specific sample, use the Inseminate gizmo instead.</description>
    <workerClass>AnimalGeneticsBreeding.Recipe_Inseminate</workerClass>
    <jobString>Inseminating.</jobString>
    <workAmount>400</workAmount>
    <genderPrerequisite>Female</genderPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>AGB_GermlineSample</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>AGB_GermlineSample</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

